{
  "name": "chrome-browser-mcp-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "Next-gen Chrome Extension & MCP Server for AI browser use — real-session control, a11y/DOM/CDP inspection, and MCP Apps UI.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:set": "node scripts/sync-version.mjs",
    "build": "node scripts/sync-version.mjs && pnpm --filter @chrome-browser-mcp/protocol build && pnpm --filter @chrome-browser-mcp/mcp-app build && pnpm --filter chrome-browser-mcp build && pnpm --filter @chrome-browser-mcp/extension build",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter @chrome-browser-mcp/protocol build && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "pair": "node packages/server/dist/cli.js pair",
    "token": "node packages/server/dist/cli.js token",
    "daemon": "node packages/server/dist/cli.js daemon",
    "security:staged": "node scripts/security-check.mjs --staged",
    "security:check": "node scripts/security-check.mjs --full",
    "icons": "node scripts/generate-icons.mjs",
    "pack:cws": "pnpm --filter @chrome-browser-mcp/extension build && node scripts/pack-cws.mjs",
    "publish:cws": "node scripts/publish-cws.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
