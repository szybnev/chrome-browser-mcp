{
  "name": "chrome-browser-mcp",
  "version": "2.3.1",
  "description": "Local Broker Daemon & MCP Server (Streamable HTTP + stdio + MCP Apps) for Chrome Browser MCP extension.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chrome-browser-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-app-html.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrome-browser-mcp/protocol": "workspace:*",
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
