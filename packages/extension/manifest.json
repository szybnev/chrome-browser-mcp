{
  "manifest_version": 3,
  "name": "Chrome Browser MCP — AI Agent Bridge",
  "short_name": "Browser MCP",
  "version": "2.3.0",
  "description": "Connect local AI assistants to your real browser tabs with AI Agent tab grouping, workflow recording, WebMCP, and instant pause.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Chrome Browser MCP Control HUD",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "alarms",
    "scripting",
    "debugger",
    "contextMenus"
  ],
  "optional_permissions": ["downloads", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Emergency Pause / Resume AI browser automation"
    }
  }
}
