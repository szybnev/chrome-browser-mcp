#!/usr/bin/env bash
set -euo pipefail

echo "▶ [pre-commit] Running security & secret scan on staged files..."
node scripts/security-check.mjs --staged

echo "▶ [pre-commit] Running Biome strict check & lint..."
pnpm check

echo "▶ [pre-commit] Running TypeScript typecheck..."
pnpm typecheck

echo "▶ [pre-commit] Running automated tests..."
pnpm test

echo "✓ [pre-commit] All checks passed."
