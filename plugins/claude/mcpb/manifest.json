{
  "manifest_version": "0.3",
  "name": "chrome-browser-mcp",
  "display_name": "Chrome Browser MCP",
  "version": "2.3.0",
  "description": "Real-session AI browser control for Chrome, Arc, Brave & Edge with hybrid Content Script + on-demand CDP, WebMCP, Prompt-Injection Shield, Workflow Recorder, and Browser Control Deck MCP App.",
  "author": {
    "name": "Chrome Browser MCP",
    "url": "https://github.com/szybnev/chrome-browser-mcp"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/szybnev/chrome-browser-mcp.git"
  },
  "homepage": "https://github.com/szybnev/chrome-browser-mcp",
  "license": "MIT",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/cli.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/cli.js", "stdio"],
      "env": {
        "CHROME_BROWSER_MCP_PORT": "${user_config.broker_port}"
      }
    }
  },
  "user_config": {
    "broker_port": {
      "type": "string",
      "title": "Local Broker Port",
      "description": "Loopback port on 127.0.0.1 for the shared Chrome Browser MCP Broker Daemon.",
      "default": "43179",
      "required": false
    }
  },
  "tools_generated": true,
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=24.0.0"
    }
  }
}
